DATABASE_URL="postgresql://postgres:password@localhost:5432/trofeo_db"
REDIS_URL="redis://localhost:6379"

# ─── Auth ───────────────────────────────────────────────────────
AUTH_SECRET="your-super-secret-key-change-in-production-min-32-chars"
AUTH_URL="http://localhost:3000"

# Google OAuth (optional)
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# ─── AI Providers ──────────────────────────────────────────────
# Set AI_PROVIDER to: demo | openai | anthropic | google | ollama
AI_PROVIDER="demo"

OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o"

ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-3-5-sonnet-20241022"

GOOGLE_API_KEY=""
GOOGLE_MODEL="gemini-1.5-pro"

OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3.2"

VLLM_BASE_URL="http://localhost:8000"
VLLM_MODEL="meta-llama/Llama-3.1-8B-Instruct"

# ─── App ────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="TROFEO"
NEXT_PUBLIC_DEMO_MODE="true"

# ─── Rate Limiting ──────────────────────────────────────────────
RATE_LIMIT_FREE_MESSAGES=20
RATE_LIMIT_CREATOR_MESSAGES=200
RATE_LIMIT_PRO_MESSAGES=2000

# ─── Storage (future) ───────────────────────────────────────────
